# VITE_API_URL: Base URL of the backend API when it's hosted on a different
# origin than the frontend — this is the normal case when deploying the
# frontend to Vercel and the backend to Render. Leave blank only for local
# dev or a same-origin deployment.
# Set this in the Vercel project's Environment Variables, e.g.:
# VITE_API_URL="https://wonderkids-backend.onrender.com"
VITE_API_URL=""

# VITE_API_PROXY_TARGET: Only used by `vite dev` to proxy /api requests to the
# backend server while developing locally.
VITE_API_PROXY_TARGET="http://localhost:4000"
