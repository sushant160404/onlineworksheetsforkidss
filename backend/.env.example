# NODE_ENV: "production" on Render, "development" locally.
NODE_ENV=development

# PORT: Port the API server listens on. Render sets this automatically —
# only needed for local dev.
PORT=4000

# CORS_ORIGIN: Origin(s) allowed to call this API — the frontend's URL(s).
# Comma-separate multiple origins, e.g. your production domain + Vercel preview URLs:
# CORS_ORIGIN="https://your-app.vercel.app,https://your-app-git-main-you.vercel.app"
CORS_ORIGIN="http://localhost:5173"

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/wonderkids?retryWrites=true&w=majority)
# Strongly recommended in production — without it the app falls back to a local
# JSON file that does NOT persist reliably on Render (ephemeral filesystem).
MONGODB_URI=""

# JWT_SECRET: Secret key for signing user authentication tokens.
# Set a strong random value in production (Render can auto-generate one — see render.yaml).
JWT_SECRET="wonderkids_super_secure_jwt_secret_key_2026"
